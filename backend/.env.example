PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# Email (for real verification emails - using a service like SendGrid, Mailgun, or SMTP)
# In production, set these to real SMTP credentials so verification emails
# are actually delivered. In sandbox/dev, EMAIL_MODE=console just logs the
# verification link instead of sending mail.
EMAIL_MODE=console            # 'console' | 'smtp'
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="PartSniper <no-reply@partsniper.app>"

# Frontend URL (for email verification links)
FRONTEND_URL=http://localhost:3000

# Database (production - PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/partsniper
